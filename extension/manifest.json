{
  "manifest_version": 3,
  "name": "MyCloud Share",
  "version": "0.2.0",
  "description": "Compartilhe arquivos entre navegadores via URL.",
  "action": { "default_popup": "popup.html" },
  "permissions": ["storage", "clipboardWrite", "activeTab", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
